# Server-only settings. Never put real keys in this example file.
# Select morrono to load its separate key from secrets/morrono-api.env.
AI_PROVIDER=openai-compatible
OPENAI_API_KEY=
# Set the provider's verified HTTPS endpoint before making API calls.
# Codyssey: https://copa.codyssey.kr/v1
# OpenAI: https://api.openai.com/v1
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
OPENAI_MODEL=gpt-5-mini

# Local preview uses SQLite. Select firestore only after configuring Firebase.
STORAGE_BACKEND=local
# Enable member login after provisioning an account in the selected storage backend.
CLOSET_LOGIN_REQUIRED=false
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional server-only MP3 path for an audio file cleared for distribution.
BACKGROUND_MUSIC_PATH=
APP_ENV=local
ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Persistent daily request budget across this backend; failures also count.
AI_DAILY_LIMIT=100
CONVERSATION_RETENTION_DAYS=5
# Enable only after configuring and verifying an image-capable provider.
IMAGE_ANALYSIS_ENABLED=false
# Enable only after a real image-edit model passes a garment quality test.
GARMENT_IMAGE_ENABLED=false
GARMENT_IMAGE_MODEL=
# Set to 0 to keep recording image usage without enforcing an app-level daily limit.
GARMENT_IMAGE_DAILY_LIMIT=10
